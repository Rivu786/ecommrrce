generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  settings          TenantSettings?
  users             User[]
  apiKeys           ApiKey[]
  auditLogs         AuditLog[]
  categories        Category[]
  products          Product[]
  attributes        Attribute[]
  warehouses        Warehouse[]
  carts             Cart[]
  orders            Order[]
  coupons           Coupon[]
  giftCards         GiftCard[]
  cmsPages          CmsPage[]
  reviews           Review[]
  analyticsEvents   AnalyticsEvent[]
  vendors           Vendor[]
  companies         Company[]
  subscriptionPlans SubscriptionPlan[]
  shippingZones     ShippingZone[]
  drivers           Driver[]
  webhooks          WebhookEndpoint[]
  tags              Tag[]
  wishlists         Wishlist[]
  faqs              Faq[]
  bundles           Bundle[]
  permissionPack    TenantPermissionPack?
  tenantRoles       TenantRole[]
  serviceProviders  ServiceProvider[]
  requirements      Requirement[]
  purchaseOrders    PurchaseOrder[]
  mediaAssets       MediaAsset[]

  @@map("tenants")
}

model TenantSettings {
  id                   String   @id @default(uuid())
  tenantId             String   @unique @map("tenant_id")
  logoUrl              String?  @map("logo_url") @db.Text
  faviconUrl           String?  @map("favicon_url") @db.Text
  primaryColor         String   @default("#0f172a") @map("primary_color")
  currencyCode         String   @default("INR") @map("currency_code")
  locale               String   @default("en-IN")
  timezone             String   @default("Asia/Kolkata")
  translationsJson     Json?    @map("translations_json")
  taxRulesJson         Json?    @map("tax_rules_json")
  businessHoursJson    Json?    @map("business_hours_json")
  pdfTemplateJson      Json?    @map("pdf_template_json")
  deliveryRadiusKm     Decimal? @map("delivery_radius_km") @db.Decimal(10, 2)
  upiId                String?  @map("upi_id")
  bankAccountNumber    String?  @map("bank_account_number")
  bankIfsc             String?  @map("bank_ifsc")
  bankBeneficiaryName  String?  @map("bank_beneficiary_name")
  tenantBankReference  String?  @map("tenant_bank_reference")
  corsOrigins          String?  @map("cors_origins") @db.Text
  lowStockThreshold    Int      @default(5) @map("low_stock_threshold")
  gstin                String?
  legalAddress         String?  @map("legal_address") @db.Text
  supportPhone         String?  @map("support_phone")
  letterheadUrl        String?  @map("letterhead_url") @db.Text
  skuPrefix            String?  @map("sku_prefix")
  deliveryCommissionPct Decimal @default(10) @map("delivery_commission_pct") @db.Decimal(5, 2)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String?   @map("tenant_id")
  email        String
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles             UserRole[]
  addresses         Address[]
  carts             Cart[]
  orders            Order[]
  reviews           Review[]
  wishlists         Wishlist[]
  loyaltyAccount    LoyaltyAccount?
  companyUsers      CompanyUser[]
  driver            Driver?
  vendorUsers       VendorUser[]
  auditLogs         AuditLog[]
  storeCredits      StoreCredit[]
  comparisonLists   ComparisonList[]
  refreshTokens     RefreshToken[]
  tenantRoles       UserTenantRole[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid())
  code  String           @unique
  name  String
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  name       String
  keyHash    String    @map("key_hash")
  keyPrefix  String    @map("key_prefix")
  scopesJson Json?     @map("scopes_json")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, keyPrefix])
  @@map("api_keys")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?  @map("tenant_id")
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  ip         String?
  metaJson   Json?    @map("meta_json")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model Category {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  parentId         String?  @map("parent_id")
  name             String
  slug             String
  description      String?  @db.Text
  imageUrl         String?  @map("image_url") @db.Text
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  metaTitle        String?  @map("meta_title")
  metaDescription  String?  @map("meta_description") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products ProductCategory[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Product {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  vendorId        String?  @map("vendor_id")
  name            String
  slug            String
  description     String?  @db.LongText
  sku             String?
  brand           String?
  weight          Decimal? @db.Decimal(12, 3)
  dimensionsJson  Json?    @map("dimensions_json")
  status          String   @default("DRAFT")
  isTaxExempt     Boolean  @default(false) @map("is_tax_exempt")
  prepTimeMinutes Int?     @map("prep_time_minutes")
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  popularityScore Int      @default(0) @map("popularity_score")
  allowSpecialInstructions Boolean @default(false) @map("allow_special_instructions")
  specialInstructionsRequired Boolean @default(false) @map("special_instructions_required")
  canonicalUrl    String?  @map("canonical_url") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor     Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  images     ProductImage[]
  categories ProductCategory[]
  tags       ProductTag[]
  attributes ProductAttributeValue[]
  addonGroups AddonGroup[]
  relationsFrom ProductRelation[] @relation("ProductFrom")
  relationsTo   ProductRelation[] @relation("ProductTo")
  reviews    Review[]
  faqs       Faq[]
  bundleItems BundleItem[]
  subscriptionPlans SubscriptionPlan[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, brand])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  productId     String   @map("product_id")
  sku           String
  name          String?
  attributesJson Json?   @map("attributes_json")
  price         Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  barcode       String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  images           ProductImage[]
  inventoryLevels  InventoryLevel[]
  stockReservations StockReservation[]
  cartItems        CartItem[]
  orderItems       OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@map("product_variants")
}

model MediaAsset {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  sha256    String   @db.Char(64)
  url       String   @db.Text
  filename  String
  mimeType  String   @map("mime_type")
  byteSize  Int      @map("byte_size")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sha256])
  @@index([tenantId, createdAt])
  @@map("media_assets")
}

model ProductImage {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  productId String  @map("product_id")
  variantId String? @map("variant_id")
  url       String  @db.Text
  alt       String?
  sortOrder Int     @default(0) @map("sort_order")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId])
  @@map("product_images")
}

model ProductCategory {
  productId  String @map("product_id")
  categoryId String @map("category_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model Attribute {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  type      String   @default("text")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values AttributeValue[]

  @@unique([tenantId, code])
  @@map("attributes")
}

model AttributeValue {
  id          String @id @default(uuid())
  attributeId String @map("attribute_id")
  value       String
  sortOrder   Int    @default(0) @map("sort_order")

  attribute Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products  ProductAttributeValue[]

  @@index([attributeId])
  @@map("attribute_values")
}

model ProductAttributeValue {
  productId        String @map("product_id")
  attributeValueId String @map("attribute_value_id")

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([productId, attributeValueId])
  @@map("product_attribute_values")
}

model Tag {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  name     String
  slug     String

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductTag[]

  @@unique([tenantId, slug])
  @@map("tags")
}

model ProductTag {
  productId String @map("product_id")
  tagId     String @map("tag_id")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model AddonGroup {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  productId String @map("product_id")
  name      String
  minSelect Int    @default(0) @map("min_select")
  maxSelect Int    @default(1) @map("max_select")

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  options AddonOption[]

  @@index([tenantId, productId])
  @@map("addon_groups")
}

model AddonOption {
  id              String  @id @default(uuid())
  groupId         String  @map("group_id")
  name            String
  priceAdjustment Decimal @default(0) @map("price_adjustment") @db.Decimal(12, 2)

  group AddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("addon_options")
}

model ProductRelation {
  id               String @id @default(uuid())
  tenantId         String @map("tenant_id")
  fromProductId    String @map("from_product_id")
  toProductId      String @map("to_product_id")
  relationType     String @map("relation_type")

  fromProduct Product @relation("ProductFrom", fields: [fromProductId], references: [id], onDelete: Cascade)
  toProduct   Product @relation("ProductTo", fields: [toProductId], references: [id], onDelete: Cascade)

  @@index([tenantId, fromProductId])
  @@map("product_relations")
}

model Bundle {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  slug      String
  price     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  BundleItem[]

  @@unique([tenantId, slug])
  @@map("bundles")
}

model BundleItem {
  bundleId  String @map("bundle_id")
  productId String @map("product_id")
  quantity  Int    @default(1)

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
  @@map("bundle_items")
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  code      String
  addressJson Json?  @map("address_json")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryLevels   InventoryLevel[]
  stockReservations StockReservation[]
  transfersFrom     StockTransfer[]    @relation("TransferFrom")
  transfersTo       StockTransfer[]    @relation("TransferTo")
  stockAdjustments  StockAdjustment[]

  @@unique([tenantId, code])
  @@map("warehouses")
}

model InventoryLevel {
  id          String @id @default(uuid())
  tenantId    String @map("tenant_id")
  warehouseId String @map("warehouse_id")
  variantId   String @map("variant_id")
  quantity    Int    @default(0)
  reserved    Int    @default(0)

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantId])
  @@index([tenantId, variantId])
  @@map("inventory_levels")
}

model StockReservation {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  warehouseId String   @map("warehouse_id")
  variantId   String   @map("variant_id")
  cartId      String?  @map("cart_id")
  orderId     String?  @map("order_id")
  quantity    Int
  expiresAt   DateTime @map("expires_at")
  releasedAt  DateTime? @map("released_at")
  createdAt   DateTime @default(now()) @map("created_at")

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantId, expiresAt])
  @@map("stock_reservations")
}

model StockTransfer {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  fromWarehouseId String  @map("from_warehouse_id")
  toWarehouseId  String   @map("to_warehouse_id")
  variantId      String   @map("variant_id")
  quantity       Int
  status         String   @default("COMPLETED")
  createdAt      DateTime @default(now()) @map("created_at")

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("stock_transfers")
}

model StockAdjustment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  warehouseId String   @map("warehouse_id")
  variantId   String   @map("variant_id")
  delta       Int
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("stock_adjustments")
}

model Address {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String   @map("user_id")
  label       String?
  fullName    String   @map("full_name")
  phone       String
  line1       String
  line2       String?
  city        String
  state       String?
  postalCode  String?  @map("postal_code")
  country     String   @default("IN")
  lat         Decimal? @db.Decimal(10, 7)
  lng         Decimal? @db.Decimal(10, 7)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("addresses")
}

model Cart {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  userId       String?  @map("user_id")
  sessionId    String?  @map("session_id")
  currencyCode String   @default("INR") @map("currency_code")
  couponCode   String?  @map("coupon_code")
  shippingMethod String? @map("shipping_method")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@index([tenantId, userId])
  @@index([tenantId, sessionId])
  @@map("carts")
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String @map("cart_id")
  variantId String @map("variant_id")
  quantity  Int
  addonsJson Json? @map("addons_json")
  notes     String?

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model ShippingZone {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  name      String
  countries Json?
  isActive  Boolean @default(true) @map("is_active")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rates  ShippingRate[]

  @@index([tenantId])
  @@map("shipping_zones")
}

model ShippingRate {
  id            String  @id @default(uuid())
  zoneId        String  @map("zone_id")
  name          String
  methodCode    String  @map("method_code")
  price         Decimal @db.Decimal(12, 2)
  minOrderTotal Decimal? @map("min_order_total") @db.Decimal(12, 2)
  etaHours      Int?    @map("eta_hours")

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("shipping_rates")
}

model Order {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  userId               String?  @map("user_id")
  orderNumber          String   @map("order_number")
  status               String   @default("PENDING_PAYMENT")
  fulfillmentMode      String   @default("HOME_DELIVERY") @map("fulfillment_mode")
  currencyCode         String   @default("INR") @map("currency_code")
  subtotal             Decimal  @db.Decimal(12, 2)
  discountTotal        Decimal  @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal             Decimal  @default(0) @map("tax_total") @db.Decimal(12, 2)
  shippingTotal        Decimal  @default(0) @map("shipping_total") @db.Decimal(12, 2)
  grandTotal           Decimal  @map("grand_total") @db.Decimal(12, 2)
  guestJson            Json?    @map("guest_json")
  shippingAddressJson  Json?    @map("shipping_address_json")
  tableNumber          String?  @map("table_number")
  notes                String?  @db.Text
  couponCode           String?  @map("coupon_code")
  vendorId             String?  @map("vendor_id")
  parentOrderId        String?  @map("parent_order_id")
  quoteId              String?  @map("quote_id")
  subscriptionId       String?  @map("subscription_id")
  channel              String   @default("ONLINE")
  soldByStaffId        String?  @map("sold_by_staff_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payment     Payment?
  shipments   Shipment[]
  invoice     Invoice?
  receipt     Receipt?
  returns     ReturnRequest[]
  deliveryJob DeliveryJob?
  parentOrder Order?       @relation("OrderSplit", fields: [parentOrderId], references: [id], onDelete: SetNull)
  childOrders Order[]      @relation("OrderSplit")

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, userId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  variantId   String  @map("variant_id")
  productName String  @map("product_name")
  sku         String
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  addonsJson  Json?   @map("addons_json")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
