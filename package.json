{
  "name": "omnicommerce",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @omnicommerce/api exec prisma generate",
    "db:push": "pnpm --filter @omnicommerce/api exec prisma db push",
    "db:seed": "pnpm --filter @omnicommerce/api exec prisma db seed",
    "db:studio": "pnpm --filter @omnicommerce/api exec prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
